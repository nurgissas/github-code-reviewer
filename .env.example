# ---- Redis ----
# Used by the NestJS services. Inside Docker use redis://redis:6379.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ---- PostgreSQL (pgvector) ----
# Used by the Python agent. Inside Docker the host is "postgres".
DATABASE_URL=postgresql+asyncpg://reviewer:password123@localhost:5432/code_reviewer

# ---- GitHub ----
# Create at: https://github.com/settings/tokens  (scope: repo)
GITHUB_TOKEN=your-github-token-here

# ---- LLM providers ----
# DeepSeek is used to generate the review. Get one at:
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI is used for embeddings (RAG / pgvector search).
OPENAI_API_KEY=your-openai-api-key-here

# ---- Optional: LangSmith observability ----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=github-code-reviewer
